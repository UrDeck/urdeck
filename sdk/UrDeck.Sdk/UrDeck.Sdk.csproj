<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(UrDeckTfm)</TargetFramework>
    <Description>Widget SDK for UrDeck: attributes, Widget base class and the render context.</Description>

    <!-- Plugins are compiled against this assembly and loaded into the host's copy of it. .NET refuses to bind a
         reference to a lower assembly version, which would make the plugin load a second SDK copy and silently
         break type identity. Keep AssemblyVersion fixed until a deliberate breaking change; Version can move freely.
         0.2.0.0: ThemeColors replaced by Theme, ContentRect added to the render context (theme-and-card).
         0.3.0 (assembly version unchanged, the addition is not breaking): IWidget.IsAnimating (animation).
         0.3.0.0 / package 0.4.0: RefreshOnEventAttribute removed and RefreshOnDataAttribute added, IWidget gained Attach and
         Subscriptions, and the Data namespace arrived (data-providers). Removing a public type is breaking, so plugins
         built against 0.2.0.0 must be rebuilt.
         Package 0.5.0 (stats-gauges): Gauge, GaugeScale, ReadingDescriptor.Warning/Critical and Theme.GaugeStyle. All
         additive, so the assembly version stays.
         Package 0.6.0 (weather): ReadingValue time, ReadingKind.Time, ReadingFormatOptions.Use24HourClock,
         IReadingSource.RegionUses24HourClock and IWidgetHost.Log, IWidget.AnimationFrameInterval and IWidget.NextAnimationAt (default members), ReadingAttribution, the Attribution and LottieAnimation
         components, and the SkiaSharp.Skottie package reference. All additive, so the assembly version stays.
         Package 0.7.0 (shortcut-and-tap): Input.ITapTarget, Launch.LaunchTarget and ILauncher, Icons.IIconSource and
         IconResult, IWidgetHost.Launcher and IWidgetHost.Icons (default members), Widget.Launcher and Widget.Icons, and
         the ImageTile component. All additive, so the assembly version stays.
         Package 0.8.0 (weather-4x4-forecast): ReadingKind.Date, Speed and Depth, DepthUnit and ReadingDescriptor.DepthUnit,
         DateStyle and ReadingFormatOptions.DateStyle, IReadingSource.RegionCulture (default member) and
         ReadingFormatter.CompassPoint. All additive, so the assembly version stays.
         Package 0.9.0 (theme-typography): TextStyle, TextCase, TextFill, TextGlow and Theme.TextStyle; Readout and TextLine
         draw the style. All additive, so the assembly version stays.
         Package 0.10.0 (theme-gauges): GaugeStyle.Meter, Tach, Marker and ThickBar, GaugeTheme and its records, Theme.Gauge,
         Accent2, Ink and Ramp. All additive, so the assembly version stays.
         Package 0.11.0 (theme-widget-parts): Chip, Divider, Well and Sparkline, Theme.Chip, Divider and Well, GaugeTheme.Sparkline
         and Status, GaugeOptions.History and Status. All additive, so the assembly version stays.
         Package 0.12.0 (themes-carbon-paper): GaugeTheme.ReadoutGap. Additive, so the assembly version stays.
         Package 0.13.0 (theme-icons): IIconSet, IconGlyph, IconShape, IconTheme, Theme.Icons and the ThemedIcon component;
         ImageTile.Draw gained a glyphKey parameter (a source-breaking change for callers that pass the later arguments
         positionally; the product has not shipped). The assembly version stays. -->
    <Version>0.13.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrDeck.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.Skottie" />
  </ItemGroup>

</Project>
