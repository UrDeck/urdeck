<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>[UrDeck.Engine]*</Include>
    <Threshold>65</Threshold>
    <ThresholdType>line</ThresholdType>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)../../artifacts/coverage/</CoverletOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Line-coverage floor for UrDeck.Engine. Run: dotnet test tests/UrDeck.Engine.Tests -p:CollectCoverage=true -->
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UrDeck.Engine\UrDeck.Engine.csproj" />
    <!-- The first-party Clock doubles as a sample widget for rendering tests. -->
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Clock\UrDeck.Widgets.Clock.csproj" />
    <!-- The stats widget and the system provider are tested here too. -->
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Stats\UrDeck.Widgets.Stats.csproj" />
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Weather\UrDeck.Widgets.Weather.csproj" />
    <ProjectReference Include="..\..\providers\UrDeck.Providers.System\UrDeck.Providers.System.csproj" />
    <ProjectReference Include="..\..\providers\UrDeck.Providers.Weather\UrDeck.Providers.Weather.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded answers of the weather services, fed to the provider in place of the network. -->
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
