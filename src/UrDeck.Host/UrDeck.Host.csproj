<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>$(UrDeckWindowsTfm)</TargetFramework>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <!-- Keep the output at bin/<config>/<tfm>/ so the documented paths and the snapshot command do not change. -->
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <!-- Unpackaged and self-contained: no installer and no machine-wide Windows App SDK runtime. -->
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <EnableMsixTooling>true</EnableMsixTooling>
        <!-- Program.cs has its own Main so that the snapshot command can exit before the XAML application starts. -->
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Resources/urdeck.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Win32.SystemEvents" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.Views.WinUI" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\UrDeck.Engine\UrDeck.Engine.csproj" />
        <!-- Build the built-in plugin with the host, but load it from plugins/ at runtime (not referenced). -->
        <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Clock\UrDeck.Widgets.Clock.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <None Update="urdeck-config.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- The window icon is set at runtime through AppWindow, which needs the .ico as a file. -->
        <Content Include="Resources/urdeck.ico" Link="urdeck.ico" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Drop built-in plugin assemblies into $(OutDir)plugins so the host discovers them like any third-party plugin. -->
    <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
        <MSBuild Projects="..\..\widgets\UrDeck.Widgets.Clock\UrDeck.Widgets.Clock.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_UrDeckPluginAssembly" />
        </MSBuild>
        <Copy SourceFiles="@(_UrDeckPluginAssembly)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
    </Target>
</Project>
