<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(UrDeckTfm)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\UrDeck.Sdk\UrDeck.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrDeck.Engine.Tests" />
  </ItemGroup>

  <!-- Built-in themes and their font. Inter is SIL OFL 1.1; its licence text travels with the font (Inter-OFL.txt). -->
  <ItemGroup>
    <EmbeddedResource Include="Themes\Builtin\*.json;Themes\Builtin\*.ttf;Themes\Builtin\*.txt" LogicalName="UrDeck.Themes.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Built-in backgrounds: one folder each (manifest.json, the .sksl, sample pictures). They are the examples for a user's own
       backgrounds/<name>/. RecursiveDir is "<name>\" on Windows, so the logical name turns the backslash into the "/" that
       EmbeddedBackgroundSource looks up: UrDeck.Backgrounds.<name>/<file>. -->
  <ItemGroup>
    <EmbeddedResource Include="Backgrounds\Builtin\**\*.sksl;Backgrounds\Builtin\**\manifest.json;Backgrounds\Builtin\**\*.png"
                      LogicalName="UrDeck.Backgrounds.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Built-in icon sets: one folder each (manifest.json, the .svg files, the licence). Logical name UrDeck.Icons.<set>/<file>. -->
  <ItemGroup>
    <EmbeddedResource Include="Icons\Builtin\**\*.svg;Icons\Builtin\**\manifest.json;Icons\Builtin\**\LICENSE*.txt"
                      LogicalName="UrDeck.Icons.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
