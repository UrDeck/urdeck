{
  "$schema": "https://urdeck.app/schemas/v1/shader-manifest.json",
  "manifest": 1,
  "title": "Plotter",
  "description": "A drafting grid with a slow scan line and dashed rings that pulse out and vanish.",
  "author": "Patrick Bigler",
  "license": "GPL-3.0-or-later",
  "version": "1.0.0",
  "tags": [
    "technical",
    "business",
    "blueprint"
  ],
  "pairsWith": {
    "themes": [
      "carbon",
      "paper",
      "blueprint"
    ]
  },
  "parameters": {
    "cells": {
      "label": "Cells",
      "description": "Number of major grid cells across the width.",
      "min": 6,
      "max": 40,
      "step": 1
    },
    "ringRate": {
      "label": "Ring size",
      "description": "How far the rings grow; 1 is the designed look.",
      "min": 0.3,
      "max": 2,
      "step": 0.05
    },
    "scan": {
      "label": "Scan line",
      "description": "Brightness of the scan line; 0 hides it.",
      "min": 0,
      "max": 2,
      "step": 0.05
    }
  },
  "samples": [
    {
      "type": "image",
      "file": "sample.png",
      "caption": "Plotter in the Blueprint palette",
      "settings": {
        "size": "270x480",
        "time": 10,
        "theme": "blueprint",
        "colors": [
          "#0c2d52",
          "#123c6b",
          "#9fd0ff",
          "#ffd34d"
        ]
      }
    }
  ]
}
