{
  "$schema": "https://urdeck.app/schemas/v1/shader-manifest.json",
  "manifest": 1,
  "title": "Nebula",
  "description": "Drifting colour clouds with an irregular scatter of twinkling stars, some in loose clusters.",
  "author": "Patrick Bigler",
  "license": "GPL-3.0-or-later",
  "version": "1.0.0",
  "tags": [
    "space",
    "calm"
  ],
  "pairsWith": {
    "themes": [
      "carbon",
      "prism",
      "obsidian"
    ]
  },
  "parameters": {
    "zoom": {
      "label": "Zoom",
      "description": "Scale of the clouds; larger is closer.",
      "min": 0.5,
      "max": 2.5,
      "step": 0.05
    },
    "starDensity": {
      "label": "Star density",
      "description": "How many stars.",
      "min": 0,
      "max": 3,
      "step": 0.05
    },
    "starClustering": {
      "label": "Star clustering",
      "description": "0 spreads the stars evenly, 1 gathers them into clumps.",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "twinkle": {
      "label": "Twinkle",
      "description": "How much the stars flicker.",
      "min": 0,
      "max": 2,
      "step": 0.05
    }
  },
  "samples": [
    {
      "type": "image",
      "file": "sample.png",
      "caption": "Nebula in the Obsidian palette",
      "settings": {
        "size": "270x480",
        "time": 10,
        "theme": "obsidian",
        "colors": [
          "#0a0908",
          "#2a2114",
          "#6b5528",
          "#d9b86c"
        ]
      }
    }
  ]
}
