<Project Sdk="Microsoft.NET.Sdk">

  <!-- The preview renderer: a configuration's page, or one widget alone, in a theme over a background with sample data, as
       one picture or as frames; and the sample page every picture of a theme starts from. Shared by the command line tool
       and the tests. GPL-3.0-or-later (it links the engine). It sits above both the engine and the first-party widgets and
       providers: the engine loads plugins and never references them, and the plugins reference only the SDK. It references
       the providers for the sample files they carry; it never creates a real provider. -->
  <PropertyGroup>
    <TargetFramework>$(UrDeckTfm)</TargetFramework>
    <RootNamespace>UrDeck.Preview</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UrDeck.Engine\UrDeck.Engine.csproj" />
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Clock\UrDeck.Widgets.Clock.csproj" />
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Stats\UrDeck.Widgets.Stats.csproj" />
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Weather\UrDeck.Widgets.Weather.csproj" />
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.Shortcut\UrDeck.Widgets.Shortcut.csproj" />
    <ProjectReference Include="..\..\widgets\UrDeck.Widgets.NowPlaying\UrDeck.Widgets.NowPlaying.csproj" />
    <ProjectReference Include="..\..\providers\UrDeck.Providers.Media\UrDeck.Providers.Media.csproj" />
    <ProjectReference Include="..\..\providers\UrDeck.Providers.System\UrDeck.Providers.System.csproj" />
    <ProjectReference Include="..\..\providers\UrDeck.Providers.Weather\UrDeck.Providers.Weather.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrDeck.Engine.Tests" />
  </ItemGroup>

  <!-- The sample page: an ordinary urdeck-config.json (preview-rendering, "The Sample Page"). -->
  <ItemGroup>
    <EmbeddedResource Include="SamplePage\urdeck-config.json" LogicalName="UrDeck.Preview.sample-page.json" />
  </ItemGroup>

</Project>
