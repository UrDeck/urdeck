<Project Sdk="Microsoft.NET.Sdk">

  <!-- urdeck-cli: checks and renders a background folder without a deck. GPL-3.0-or-later (it links the engine); running it
       on a shader does not change the shader's licence (docs/backgrounds.md). Uses only the engine's public API: it is
       deliberately not in the engine's InternalsVisibleTo. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(UrDeckTfm)</TargetFramework>
    <AssemblyName>urdeck-cli</AssemblyName>
    <RootNamespace>UrDeck.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>urdeck-cli</ToolCommandName>
    <PackageId>urdeck-cli</PackageId>
    <Description>Checks and renders UrDeck background folders (shader validate, shader render) without a deck.</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotMake.CommandLine" />
    <!-- SkiaSharp's native library on Linux (Windows ships it with SkiaSharp). Keep the version equal to SkiaSharp's. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UrDeck.Engine\UrDeck.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrDeck.Cli.Tests" />
  </ItemGroup>

</Project>
