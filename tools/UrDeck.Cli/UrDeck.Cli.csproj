<Project Sdk="Microsoft.NET.Sdk">

  <!-- urdeck-cli: checks and renders a background or a theme folder without a deck. GPL-3.0-or-later (it links the engine); running it
       on a shader does not change the shader's licence (the site's "The command line tool" page). Uses only the engine's public API: it is
       deliberately not in the engine's InternalsVisibleTo. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(UrDeckTfm)</TargetFramework>
    <AssemblyName>urdeck-cli</AssemblyName>
    <RootNamespace>UrDeck.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>urdeck-cli</ToolCommandName>
    <PackageId>urdeck-cli</PackageId>
    <Description>Checks, renders and starts UrDeck background and theme folders (shader validate|render|init, theme validate|render|init|schema) without a deck.</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotMake.CommandLine" />
    <!-- SkiaSharp's native library on Linux (Windows ships it with SkiaSharp). Keep the version equal to SkiaSharp's. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UrDeck.Engine\UrDeck.Engine.csproj" />
    <!-- The sample page and its renderer, for theme render; brings the four first-party widgets into the tool. -->
    <ProjectReference Include="..\..\src\UrDeck.Preview\UrDeck.Preview.csproj" />
  </ItemGroup>

  <!-- The published theme schema, so that `theme schema` prints the file the product publishes and not a copy. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\schemas\v2\theme.json" LogicalName="UrDeck.Cli.theme.schema.json" Link="theme.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrDeck.Cli.Tests" />
  </ItemGroup>

</Project>
