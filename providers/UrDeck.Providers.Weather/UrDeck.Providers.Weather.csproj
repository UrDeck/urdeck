<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(UrDeckTfm)</TargetFramework>
    <Description>First-party data provider for weather readings from Open-Meteo, for any number of places.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- UrDeck.Sdk and SkiaSharp are provided by the host at runtime; don't copy them next to the plugin. -->
    <ProjectReference Include="..\..\sdk\UrDeck.Sdk\UrDeck.Sdk.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UrDeck.Engine.Tests" />
  </ItemGroup>

  <!-- Made-up readings for previews, the picture tests and the host's demo mode (docs: "Sample files"). -->
  <ItemGroup>
    <EmbeddedResource Include="sample.json" LogicalName="urdeck.sample.weather.json" />
  </ItemGroup>

</Project>
