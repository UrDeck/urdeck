<Project>

  <PropertyGroup>
    <Product>UrDeck</Product>
    <Authors>Patrick Bigler</Authors>
    <Copyright>Copyright (C) 2026 Patrick Bigler</Copyright>
    <RepositoryUrl>https://github.com/UrDeck/urdeck</RepositoryUrl>
    <!-- Default license (host, engine, widgets, tests). The plugin exception is in PLUGIN-EXCEPTION.md; projects with a
         different license (the analyzer, later the SDK) override this and ship their own LICENSE file. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Target frameworks shared by the projects. The Windows SDK suffix matters: the Windows App SDK and
         SkiaSharp.Views.WinUI target net10.0-windows10.0.19041; plain net10.0-windows does not resolve them. -->
    <UrDeckTfm>net10.0</UrDeckTfm>
    <UrDeckWindowsTfm>net10.0-windows10.0.19041.0</UrDeckWindowsTfm>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Required for IDE0005 (unused usings) to run during build; missing-XML-doc warnings stay off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet vulnerability audit of direct and transitive packages. With TreatWarningsAsErrors a known-vulnerable
         package (NU1901-NU1904) fails the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- The app's version (release-process spec). It travels in UrDeckAppVersion, not Version: a global property flows to every
       referenced project, and -p:Version would also stamp UrDeck.Sdk, whose version follows its own changes. Projects outside
       sdk/ take it; a build without it is 0.0.0-dev. A project that sets its own Version (the tool) keeps it. -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)sdk'))">
    <Version Condition="'$(UrDeckAppVersion)' != ''">$(UrDeckAppVersion)</Version>
    <Version Condition="'$(UrDeckAppVersion)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <!-- Test projects: xunit v3 on the plain TFM, so they run on Windows and Linux (the host is the only project that
       needs Windows; a test of Windows-only code says so, see tests/UrDeck.Engine.Tests/Support/WindowsOnlyAttributes.cs). Never packed. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <TargetFramework>$(UrDeckTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
