{
  "$schema": "https://urdeck.app/schemas/v1/shader-manifest.json",
  "manifest": 1,
  "title": "Embers",
  "description": "Sparks lifting off a glowing horizon and fading as they rise. Dark at the top where widgets live.",
  "author": "Patrick Bigler",
  "license": "GPL-3.0-or-later",
  "version": "1.0.0",
  "tags": [
    "fire",
    "warm",
    "gaming"
  ],
  "pairsWith": {
    "themes": [
      "rigline",
      "ember"
    ]
  },
  "parameters": {
    "density": {
      "label": "Density",
      "description": "How many sparks.",
      "min": 0.2,
      "max": 2,
      "step": 0.05
    },
    "heat": {
      "label": "Heat",
      "description": "Strength of the glow at the bottom.",
      "min": 0,
      "max": 2,
      "step": 0.05
    }
  },
  "samples": [
    {
      "type": "image",
      "file": "sample.png",
      "caption": "Embers in the Ember palette",
      "settings": {
        "size": "270x480",
        "time": 10,
        "theme": "ember",
        "colors": [
          "#0b0604",
          "#5a1a07",
          "#ff7a1a",
          "#ffd9a0"
        ]
      }
    }
  ]
}
