// SPDX-License-Identifier: GPL-3.0-or-later
// Warped clouds of palette colour under an uneven star field: a dense band, scattered strays and a few bright
// stars that glow and twinkle on their own timing. Palette roles: iColor0 space, iColor1..3 cloud colours.
// The clouds drift with a period of 240 s; every star twinkles with a period of 6, 8 or 10 s: all divide the four-hour wrap.
uniform float iTime;
uniform float2 iResolution;
uniform float4 iColor0;
uniform float4 iColor1;
uniform float4 iColor2;
uniform float4 iColor3;
uniform float zoom;             // default: 1.0
uniform float starDensity;      // default: 1.0
uniform float starClustering;   // default: 0.6
uniform float twinkle;          // default: 1.0

float hash21(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = p * 2.03 + 11.7;
        a *= 0.5;
    }
    return v;
}

// One layer of stars: the plane is cut into cells, each cell may hold one star at a random place.
float stars(float2 p, float cell, float chance, float bandWeight, float seed, float t) {
    float2 g = p / cell;
    float2 id = floor(g);
    float2 f = fract(g);
    float r = hash21(id + seed);
    // The galactic band: a diagonal ribbon where stars are more likely.
    float band = exp(-pow((p.x * 0.8 + p.y * 0.55 - 0.55) * 2.4, 2.0));
    float prob = chance * mix(1.0, 0.25 + 2.6 * band, bandWeight);
    if (r > prob) return 0.0;
    float2 pos = float2(hash21(id + seed + 7.1), hash21(id + seed + 13.7)) * 0.7 + 0.15;
    float mag = hash21(id + seed + 29.3);
    float size = 0.010 + 0.035 * pow(mag, 5.0);               // most stars are tiny, very few are big
    float d = length((f - pos) * cell);
    float core = smoothstep(size * cell * 1.6, 0.0, d);
    // The halo falls off well inside the cell (0.3 of it), so no cell edge shows.
    float halo = exp(-d / (cell * 0.05)) * pow(mag, 6.0) * 0.55;
    float period = 6.0 + 2.0 * floor(hash21(id + seed + 3.3) * 3.0);   // 6, 8 or 10 s
    float tw = 1.0 - twinkle * 0.45 * (0.5 + 0.5 * sin(6.2831853 * t / period + hash21(id + seed) * 6.2831853));
    float tint = hash21(id + seed + 41.0);
    return (core + halo) * tw * (0.55 + 0.45 * mag) * (0.8 + 0.2 * tint);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float ar = iResolution.x / iResolution.y;
    float2 p = float2(uv.x * ar, uv.y);
    float t = iTime * (6.2831853 / 240.0);

    // Domain-warped clouds.
    float2 q = p * 1.6 / zoom;
    float2 w = float2(fbm(q + float2(0.0, t * 6.0)), fbm(q + float2(5.2, 1.3) - t * 4.0));
    float c = fbm(q + 1.8 * w + float2(sin(t) * 0.8, cos(t) * 0.8));
    float3 col = iColor0.rgb;
    col = mix(col, iColor1.rgb, smoothstep(0.2, 0.6, c));
    col = mix(col, iColor2.rgb, smoothstep(0.35, 0.8, w.x) * 0.85);
    col = mix(col, iColor3.rgb, smoothstep(0.4, 0.85, w.y * c * 1.8) * 0.8);
    col *= 0.7 + 0.9 * c;

    // Stars in three sizes of cell, so they do not line up on a grid.
    float s = 0.0;
    float dens = clamp(starDensity, 0.0, 3.0);
    s += stars(p, 0.045, 0.30 * dens, starClustering, 1.0, iTime);
    s += stars(p + 0.37, 0.085, 0.22 * dens, starClustering, 17.0, iTime);
    s += stars(p + 0.71, 0.19, 0.18 * dens, starClustering, 53.0, iTime);
    float3 starCol = mix(float3(1.0), mix(iColor3.rgb, float3(1.0), 0.6), 0.5);
    col += starCol * s;
    return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
}
