// SPDX-License-Identifier: GPL-3.0-or-later
// A drafting grid with a slow scan line and dashed rings that pulse out and vanish, like a plotter proofing a sheet.
// Palette roles: iColor0 paper, iColor1 minor grid, iColor2 major grid and rings, iColor3 scan line.
// The scan takes 12 s and the rings 6 s, both divide the four-hour time wrap.
uniform float iTime;
uniform float2 iResolution;
uniform float4 iColor0;
uniform float4 iColor1;
uniform float4 iColor2;
uniform float4 iColor3;
uniform float cells;      // default: 16.0
uniform float ringRate;   // default: 1.0
uniform float scan;       // default: 1.0

float hash11(float n) { return fract(sin(n * 78.233) * 43758.5453); }

float gridLine(float v, float px, float w) {
    float d = abs(fract(v - 0.5) - 0.5);                 // distance to the nearest integer in cell units
    return 1.0 - smoothstep(w * px, w * px + px, d);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float ar = iResolution.x / iResolution.y;
    float cellPx = iResolution.x / cells;
    float2 gp = fragCoord / cellPx;
    float px = 1.0 / cellPx;                             // one pixel in cell units

    float3 col = iColor0.rgb;
    float minor = max(gridLine(gp.x * 5.0, px * 5.0, 0.5), gridLine(gp.y * 5.0, px * 5.0, 0.5));
    float major = max(gridLine(gp.x, px, 0.7), gridLine(gp.y, px, 0.7));
    col = mix(col, iColor1.rgb, minor * 0.55);
    col = mix(col, iColor2.rgb, major * 0.55);

    // The scan line sweeps from top to bottom; a glow trails above it.
    float s = fract(iTime / 12.0);
    float dy = uv.y - s;
    float trail = dy < 0.0 ? exp(dy * 14.0) : 0.0;
    float edge = exp(-abs(dy) * 260.0);
    col += iColor3.rgb * (trail * 0.10 + edge * 0.85) * scan;

    // Rings: every 6 s a new ring grows from a place chosen by the cycle number, dashed and fading.
    for (int k = 0; k < 2; k++) {
        float fk = float(k);
        float u = iTime / 6.0 + fk * 0.5;
        float cycle = floor(u);
        float ph = fract(u);
        float2 c = float2(hash11(cycle * 1.3 + fk * 7.0), hash11(cycle * 2.1 + fk * 3.0)) * float2(0.7, 0.8) + float2(0.15, 0.1);
        float2 q = float2((uv.x - c.x) * ar, uv.y - c.y);
        float radius = ph * 0.34 * ringRate;
        float dr = abs(length(q) - radius);
        float ang = atan(q.y, q.x);
        float dash = step(0.5, fract(ang * 5.0 + iTime * 0.05));
        float ring = (1.0 - smoothstep(0.0015, 0.0045, dr)) * dash * (1.0 - ph) * (smoothstep(0.0, 0.08, ph));
        col = mix(col, iColor2.rgb, ring * 0.9);
    }
    return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
}
