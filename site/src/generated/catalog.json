    },
    {
      "code": "THEME041",
      "severity": "warning",
      "summary": "`meta.pairsWith.backgrounds` names a background that does not exist: fix the name or remove it"
    },
    {
      "code": "THEME042",
      "severity": "warning",
      "summary": "the default background is not in the theme's own `pairsWith` list: add it"
    },
    {
      "code": "THEME043",
      "severity": "warning",
      "summary": "the still background picture is missing, leaves the folder or is over 8 MB"
    },
    {
      "code": "THEME044",
      "severity": "warning",
      "summary": "`icons.set` names an icon set that exists neither in the theme's `icons/` folder nor among the built-in sets (also logged): fix the name"
    },
    {
      "code": "THEME050",
      "severity": "warning",
      "summary": "a border style, gradient or animation with `card.borderWidth` 0 (also logged): give the border a width"
    },
    {
      "code": "THEME051",
      "severity": "warning",
      "summary": "`card.borderAnimate` `spin` without a conic `card.borderGradient` (also logged): the deck switches the animation off"
    },
    {
      "code": "THEME052",
      "severity": "warning",
      "summary": "a pattern whose marks are closer than three pixels at the panel width (also logged): raise `spacing`"
    },
    {
      "code": "THEME053",
      "severity": "warning",
      "summary": "outside corner marks reaching past `card.gap`, thickness included (also logged): move them in or widen the gap"
    },
    {
      "code": "THEME054",
      "severity": "warning",
      "summary": "a shadow or glow whose reach is more than the gap over a translucent fill (logged as information, the deck limits it): reduce the blur or offset"
    },
    {
      "code": "THEME055",
      "severity": "warning",
      "summary": "a line (border, highlight, accent strip, corner mark) that resolves under one pixel, which the deck draws 1 px wide (also logged)"
    },
    {
      "code": "THEME056",
      "severity": "info",
      "summary": "`card.compact.shape` `circle` on a card that is not square, which is a capsule (also logged)"
    },
    {
      "code": "THEME057",
      "severity": "warning",
      "summary": "`card.borderAnimate` on a `dashed` `card.borderStyle` (also logged): the border is drawn still, because the moving ring is stretched round the card and a dash pattern fitted to each side does not survive that"
    },
    {
      "code": "THEME060",
      "severity": "warning",
      "summary": "the text colour on the card fill, or on its gradient's darkest or lightest stop, is under 4.5:1: change the colours; a translucent fill is composited over `colors.background`, and the message says so because the page behind may be a moving background"
    },
    {
      "code": "THEME061",
      "severity": "warning",
      "summary": "the text colour on a card tint is under 4.5:1 (a tinted card keeps `colors.text`): change the tint at the position the message names"
    },
    {
      "code": "THEME062",
      "severity": "info",
      "summary": "the muted text colour on the card fill is under 3:1"
    },
    {
      "code": "THEME070",
